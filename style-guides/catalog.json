      },
      "conventions": {
        "serialComma": "omit-in-simple-lists",
        "headingCase": "sentence",
        "spelling": "en-GB"
      }
    },
    {
      "id": "microsoft-zh-cn-doc",
      "name": "Microsoft · 简体中文（文档）",
      "description": "微软简体中文本地化：正文全角冒号和问号，按内容选择括号。",
      "scope": "仅用于 zh-CN／zh-Hans 的技术文档，不能把此标点规则用于软件界面。",
      "targetLocales": [
        "zh-CN",
        "zh-Hans"
      ],
      "contentType": "documentation",
      "source": "zho-chn-StyleGuide.pdf",
      "author": "Microsoft",
      "license": "本地 PDF：未核实独立开放许可；自写规则摘要，原 PDF 不打包",
      "version": "1.0.0",
      "rules": [
        {
          "id": "MZD01",
          "category": "语气",
          "instruction": "保持自然、清晰和帮助用户的语气；避免生硬逐词翻译，允许中文自然调整，但保留全部实质信息和限制。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 8
        },
        {
          "id": "MZD02",
          "category": "术语",
          "instruction": "按产品上下文和已批准术语选译名。一般 app 为应用、application 为应用程序；这些示例不是覆盖项目术语的全局替换表。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 7
        },
        {
          "id": "MZD03",
          "category": "人称",
          "instruction": "含义不变时可省去多余代词；需要指称读者时优先使用你，而不是您，除非项目另有明确要求。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 27
        },
        {
          "id": "MZD04",
          "category": "数字",
          "instruction": "计量、数据格式和公式使用数字；其他叙述参考源文和中文习惯，选择合适量词，不一律用个。保持原数值。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 26
        },
        {
          "id": "MZD05",
          "category": "缩略语",
          "instruction": "保留官方缩略语和产品名称，不随意缩写 Windows 或 Visual Studio；普通英文缩略语的复数 s 在中文中通常去掉，代码和固定标识符除外。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 17
        },
        {
          "id": "MZD06",
          "category": "标点",
          "instruction": "中文逗号、句号、顿号用于中文正文；保留文件名、小数、英文缩写中的半角句点。源 PDF 使用英文形式省略号；不要自动套其他中文指南替换为六点省略号。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 31
        },
        {
          "id": "MZD07",
          "category": "文档标点",
          "instruction": "文档正文使用全角冒号、问号和叹号，其后不额外加空格；方括号、斜杠等遵循各自用途，不做全面全角化。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 28
        },
        {
          "id": "MZD08",
          "category": "文档引号",
          "instruction": "文档中采用中文双引号，嵌套时用单引号，引用实际 UI 名称时保留名称本身的拼写。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 33
        },
        {
          "id": "MZD09",
          "category": "文档括号",
          "instruction": "括号内含中文时使用全角括号，外侧不加空格；内容仅为英文或数字时使用半角括号并按相邻文本处理外侧空格。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 35
        },
        {
          "id": "MZD10",
          "category": "文档标题",
          "instruction": "中文书籍、手册及指南标题可用书名号；只在明确知道文本是标题时应用，不给普通 UI 控件名加书名号。",
          "source": "zho-chn-StyleGuide.pdf",
          "sourcePage": 37
        }
      ],
