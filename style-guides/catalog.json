    {
      "id": "google",
      "name": "Google · Developer documentation（美式英文）",
      "description": "开发者文档；you、主动语态、先条件后操作、美式拼写和牛津逗号。",
      "scope": "面向开发者的 en-US 文档；不将英文拼写与标点要求机械套到中文或 en-GB。",
      "targetLocales": [
        "en-US"
      ],
      "contentType": "developer-documentation",
      "source": "https://developers.google.com/style/",
      "author": "Google",
      "license": "CC BY 4.0（页面内容，另有注明除外）",
      "version": "1.0.0",
      "rules": [
        {
          "id": "G01",
          "category": "优先级",
          "instruction": "优先遵守项目或产品明确规则，再参考 Google 指南；允许为清晰和领域惯例偏离，但全文保持一致。",
          "source": "https://developers.google.com/style/"
        },
        {
          "id": "G02",
          "category": "语气",
          "instruction": "友好、对话式、尊重读者，不用俚语、噱头、文化限定的比喻或过度随意的表达。",
          "source": "https://developers.google.com/style/tone"
        },
        {
          "id": "G03",
          "category": "表达",
          "instruction": "用第二人称 you 面向读者，明确执行动作的主体，优先主动语态；不要无依据补出施事者。",
          "source": "https://developers.google.com/style/highlights"
        },
        {
          "id": "G04",
          "category": "步骤",
          "instruction": "将适用条件放在操作指令之前；有顺序的操作使用编号，无顺序的项目使用项目符号。CAT 中不重组分段或新增标签。",
          "source": "https://developers.google.com/style/highlights"
        },
        {
          "id": "G05",
          "category": "拼写",
          "instruction": "使用标准美式英语拼写和标点；不把 colour、centre 等英式写法混入普通英文叙述。专名和代码保持官方写法。",
          "source": "https://developers.google.com/style/highlights"
        },
        {
          "id": "G06",
          "category": "大小写",
          "instruction": "文档标题和章节标题使用 sentence case，保留专名及缩略语大小写。",
          "source": "https://developers.google.com/style/highlights"
        },
        {
          "id": "G07",
          "category": "逗号",
          "instruction": "三项及以上英文列举使用 serial comma（牛津逗号）。",
          "source": "https://developers.google.com/style/highlights"
        },
        {
          "id": "G08",
          "category": "格式",
          "instruction": "代码相关文本应采用代码字体，UI 元素采用粗体。CAT 中保留已有格式标签；缺少格式时给出建议，不新增或改动受保护标签。",
          "source": "https://developers.google.com/style/highlights"
        },
        {
          "id": "G09",
          "category": "链接与日期",
          "instruction": "使用能描述目标的链接文字和无歧义日期。保留 URL、日期实际含义及占位符；日期无法判定时询问而不猜。",
          "source": "https://developers.google.com/style/highlights"
        },
        {
          "id": "G10",
          "category": "措辞",
          "instruction": "操作说明避免 simply、easy、quickly 等暗示操作轻而易举的词，不滥用 please 或 please note；不在文档中擅自预告未发布功能。",
          "source": "https://developers.google.com/style/tone"
        }
      ],
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "licenseSource": "https://developers.google.com/style/highlights",
      "conventions": {
        "serialComma": "use",
        "headingCase": "sentence",
        "spelling": "en-US"
      }
    },
    {
      "id": "apple",
      "name": "Apple · Style Guide（美式英文）",
      "description": "June 2026；Apple 产品与 UI 术语、精确操作动词、按项目选择标题大小写。",
      "scope": "基于美式英语的 Apple 技术文档、参考资料和面向用户的文字；不是中文或英式英语本地化指南，也不是 Human Interface Guidelines。",
      "targetLocales": [
        "en-US"
      ],
      "contentType": "apple-technical-documentation-and-ui",
      "source": "https://support.apple.com/zh-cn/guide/applestyleguide/apsg1eef9171/1.0/web/1.0",
      "author": "Apple Inc.",
      "license": "Copyright © 2026 Apple Inc. All rights reserved；自写规则摘要，未复制原 PDF 或套用 CC 许可。",
      "version": "1.0.0",
      "sourceDocument": {
        "fileName": "apple-style-guide.pdf",
        "title": "Apple Style Guide",
        "edition": "June 2026",
        "pages": 244,
        "sha256": "76118d81e4ff9eb74b1217ff8b82bbd01f62d1ff0057a1802bec288d20a5bbfe",
        "pdfModified": "2026-06-16",
        "downloadUrl": "https://help.apple.com/pdf/applestyleguide/en_US/apple-style-guide.pdf",
        "note": "来源为用户提供的本地 PDF；仅保存规则摘要、页码和文件指纹，PDF 不随应用分发。"
      },
      "conventions": {
        "serialComma": "use",
        "headingCase": "department-or-project-specific",
        "spelling": "en-US"
      },
      "rules": [
        {
          "id": "A01",
          "category": "适用范围",
          "instruction": "依据美式英语惯例处理 Apple 技术文档与面向用户的文字；本地化到其他语言或地区时，另查对应语言规范。网址中的 zh-cn 不表示本指南是中文本地化规则。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 5
        },
        {
          "id": "A02",
          "category": "大小写",
          "instruction": "Apple 同时采用 sentence-style 和 title-style capitalization；除 UI 外按部门／项目规范选择，保持现有一致风格，不把所有标题强制改成 sentence case。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 45
        },
        {
          "id": "A03",
          "category": "界面名称",
          "instruction": "文档中通常按屏幕所示大小写引用 UI 元素；元素全部大写或全部小写时，指南要求在文档中使用 title-style。须先确认实际 UI 标签，不改产品官方拼写或代码。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 45
        },
        {
          "id": "A04",
          "category": "标题式大小写",
          "instruction": "仅在项目采用 title-style 时：首尾词、名词、动词等实词大写；冠词和并列连词通常小写；短介词通常小写，但短语动词中的介词需大写。iPad、macOS 等固定小写开头名称保留。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 46,
          "sourcePages": [
            46,
            47
          ]
        },
        {
          "id": "A05",
          "category": "缩约",
          "instruction": "多数文档和界面可采用常见助动词／代词缩约，保持自然语气；避免将名词或专名与动词缩约，例如名词后用 isn’t 而非 ’s not。所有格不能误当缩约修改。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 57
        },
        {
          "id": "A06",
          "category": "礼貌",
          "instruction": "操作说明与交叉引用中避免不必要的 please，直接说明操作或参考位置；不削弱警告或改变请求含义。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 161
        },
        {
          "id": "A07",
          "category": "逗号",
          "instruction": "三项及以上英文列举在最后的 and／or 前使用 serial comma（牛津逗号）。不适用于代码语法。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 56
        },
        {
          "id": "A08",
          "category": "鼠标操作",
          "instruction": "通过指针操作元素时用 click，不用 click on；拖动用 drag，不写 click and drag。click in 用于窗口或区域，需根据真实动作判断。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 51
        },
        {
          "id": "A09",
          "category": "触控操作",
          "instruction": "短暂触碰并松开用 tap，不用 tap on；持续触碰用 touch and hold，不写 tap and hold。只有确定设备与动作时才替换，不把 click、tap、press 全局互换。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 201
        },
        {
          "id": "A10",
          "category": "实体按键",
          "instruction": "键盘按键、机械按钮的按下并松开用 press；持续按住应明确为 press and hold。不要把持续动作改为一次短按。特殊设备按键动作按实际产品术语处理。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 166
        },
        {
          "id": "A11",
          "category": "账号术语",
          "instruction": "当前产品的账号称 Apple Account，使用 sign in to your Apple Account；原 Apple ID 若指登录邮箱／电话号码，应写相应字段，不能一律替换为 Apple Account。历史版本、引文及旧 UI 标签按真实上下文保留。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 22
        },
        {
          "id": "A12",
          "category": "缩略语",
          "instruction": "读者可能不熟悉时，在页面或章节首次出现处解释缩略语，通常先全称再括号缩写；熟知的缩写可优先展示。不能把每个 CAT 分段都视为首次出现。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 12
        },
        {
          "id": "A13",
          "category": "单位",
          "instruction": "技术文档中数字与缩写单位通常留空格，如 20 GB；拼写完整的单位作前置复合形容词时用连字符，缩写单位不用连字符。Apple 营销部门可能采用不同口径，项目规范优先。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 230
        },
        {
          "id": "A14",
          "category": "技术文字",
          "instruction": "代码表达式和文件、目录等名称通常用代码字体；不要把命令／函数名当普通动词。CAT 中保留代码、占位符及格式标签，缺少格式时只提出建议，不自动新增标签。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 238
        },
        {
          "id": "A15",
          "category": "日期",
          "instruction": "普通美式叙述可用 Month day, year；避免歧义斜杠日期。仅在项目明确采用 International style 时使用 ISO 年-月-日及 24 小时制，不混合两套规范，不猜测含混日期。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 63,
          "sourcePages": [
            63,
            241
          ]
        },
        {
          "id": "A16",
          "category": "包容性",
          "instruction": "用词考虑不同读者的理解和潜在负面联想，尊重读者及群体称谓；不改变引文、技术标识符或自我认同，不机械删除实质信息。",
          "source": "apple-style-guide.pdf",
          "sourcePage": 223
        }
      ]
    }
  ],
